+    // Spawn Xuantie Heavy Sword clue and advance to Step 2 (wield_heavy_iron_trial: scope = 'personal', minVal = 64)
+    const xuanInst = g.VC.spawnClueInstance(W, 'CLUE_LEG_WPN_XUANTIE_HEAVY_SWORD', { forceTruth: 'true_lead' });
