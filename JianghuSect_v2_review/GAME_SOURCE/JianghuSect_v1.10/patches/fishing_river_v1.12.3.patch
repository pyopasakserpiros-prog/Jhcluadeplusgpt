+    const shBody = document.getElementById('shBody');
+    const horizOverflow = shBody.scrollWidth > shBody.clientWidth + 2;
+
+    return {
+      hasZoneEcology,
+      isFishingAct,
+      containerAtlasCell,
+      containerRemaining,
+      dishAtlasCell,
+      hasFoodBuff,
